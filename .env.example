# All optional. Defaults work for a local run.
PORT=8080
# Shared secret used to sign the recovery webhook. Change it on a real deploy.
RECOVERY_WEBHOOK_SECRET=change-me
# Leave empty to use the demo integration's own endpoint.
RECOVERY_WEBHOOK_URL=
# Override the embedded video with a hosted file or an embed URL.
VIDEO_URL=
# 1 = normal pacing, 0 = no artificial delays.
DEMO_SPEED=1
# How many calls the notification gateway rejects before it succeeds.
NOTIFY_FAIL_COUNT=1
